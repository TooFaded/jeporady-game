# Copy to .env.local and fill locally; never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-SECRET-OR-SERVICE-ROLE-KEY
# Accepted legacy HS256 signing secret (not an API key).
SUPABASE_JWT_SECRET=YOUR-ACCEPTED-HS256-SIGNING-SECRET
RATE_LIMIT_SALT=GENERATE-WITH-openssl-rand-hex-32
# Required on Vercel: set the exact HTTPS origin for this environment.
# Leave blank for local development to share the browser's LAN origin.
APP_PUBLIC_ORIGIN=
